# Copy this file to .env in the backend directory for local development.

PORT=4000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>
# Use the exact browser frontend origin(s), comma-separated (not the backend API URL).
FRONTEND_URL=http://localhost:5173

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRE=7d
COOKIE_EXPIRE=5

# Set these only when running `npm run setup-admin`; use a unique, strong password.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudinary credentials used by product image uploads and user avatars
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# UPI payment-intent details for guest checkout. Direct UPI intents do not verify payment.
# Override this default in the backend host's environment if the merchant ID changes.
PAYMENT_UPI_ID=jayshankaryadav435@okhdfcbank
PAYMENT_RECEIVER_NAME=Your Store Name

# Required only for manually running the destructive development seed.
SEED_ADMIN_PASSWORD=replace_with_a_strong_local_admin_password
SEED_USER_PASSWORD=replace_with_a_strong_local_test_password

NODE_ENV=development
